{
  "name": "codsh-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter codsh-bundle run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "dev": "node scripts/dev.mjs",
    "sync:dsh": "node scripts/sync-dsh.mjs",
    "site:screens": "pnpm run build && CAPTURE_SCREENS=1 vitest run --config vitest.e2e.config.ts e2e/capture.e2e.ts && node scripts/site-frames.mjs",
    "site:build": "node scripts/site-frames.mjs",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "execa": "^9.0.0",
    "semver": "^7.8.5",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@deepseek-ai/dsh": "^0.1.1-rc.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
